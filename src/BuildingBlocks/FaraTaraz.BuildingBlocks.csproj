<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The foundation now carries no package dependency: the unused diagnostics/error scaffolding
    (DiagnosticContext, ILogger extension, ErrorDescriptor model) was removed in Wave 3 as a
    verified-dead abstraction, so Microsoft.Extensions.Logging.Abstractions is no longer needed.
  -->

  <!--
    TenantContext trust-minting (internal constructor + FromAuthenticatedPrincipal) is restricted
    to this trusted-foundation assembly. The test assemblies below are explicitly trusted callers
    (they exercise the trusted boundary and its fail-closed negative paths), so they are granted
    internal visibility. No production assembly other than this foundation can mint a trusted
    TenantContext, which closes the FT-SEC-004 untrusted-minting gap.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="FaraTaraz.BuildingBlocks.Tests" />
    <InternalsVisibleTo Include="FaraTaraz.ArchitectureTests" />
    <InternalsVisibleTo Include="FaraTaraz.Infrastructure.IntegrationTests" />
  </ItemGroup>

</Project>
