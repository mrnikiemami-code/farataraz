<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Structured diagnostics (DiagnosticContext + ILogger extension) build on the standard
      Microsoft logging abstraction. This is not a new logging framework; it only supplies the
      ILogger/ILoggerProvider types so Diagnostics can emit structured, searchable events.
      Version pinned to match the existing Microsoft.Extensions.DependencyInjection 8.0.0.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <!--
    TenantContext trust-minting (internal constructor + FromAuthenticatedPrincipal) is restricted
    to this trusted-foundation assembly. The test assemblies below are explicitly trusted callers
    (they exercise the trusted boundary and its fail-closed negative paths), so they are granted
    internal visibility. No production assembly other than this foundation can mint a trusted
    TenantContext, which closes the FT-SEC-004 untrusted-minting gap.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="FaraTaraz.BuildingBlocks.Tests" />
    <InternalsVisibleTo Include="FaraTaraz.ArchitectureTests" />
    <InternalsVisibleTo Include="FaraTaraz.Infrastructure.IntegrationTests" />
  </ItemGroup>

</Project>
