<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\FaraTaraz.BuildingBlocks.csproj" />
    <ProjectReference Include="..\Ingestion\Ingestion.Domain\FaraTaraz.Modules.Ingestion.Domain.csproj" />
  </ItemGroup>

  <!--
    The module-owned Infrastructure subfolder (persistence) is a SEPARATE assembly. Exclude
    it from this Domain project so the SDK does not compile the Infrastructure sources into
    the Domain assembly (the Domain project directory physically contains the Infrastructure
    subfolder). Infrastructure is built and referenced only through its own assembly.
  -->
  <ItemGroup>
    <Compile Remove="AccountingSources.Infrastructure\**" />
    <None Remove="AccountingSources.Infrastructure\**" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="FaraTaraz.Modules.AccountingSources.Providers" />
    <Using Include="FaraTaraz.Modules.AccountingSources.Capabilities" />
    <Using Include="FaraTaraz.Modules.AccountingSources.Authorization" />
  </ItemGroup>
</Project>
