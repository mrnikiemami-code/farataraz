<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Module-owned composition seam for the AccountingSources module (D-1; ADR-010 decision 14).

    This project owns ONLY dependency-injection wiring: it exposes an `AddAccountingSourcesModule`
    entry point that binds the module's inward ownership port (`IAccountingSourceOwnership`) and
    persistence through the module's Infrastructure. It contains no business rules, no handler, no
    domain type, no provider concept and no tenant decision.

    It exists so the composition-only Host can wire the module's persistence WITHOUT referencing
    the concrete `AccountingSources.Infrastructure` assembly ("Host composes modules, never owns
    persistence", AGENTS.md). It is never referenced by the module's Domain or Application. Its
    dependency direction is inward: it depends on the module's Infrastructure.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccountingSources.Domain\FaraTaraz.Modules.AccountingSources.csproj" />
    <ProjectReference Include="..\AccountingSources.Infrastructure\FaraTaraz.Modules.AccountingSources.Infrastructure.csproj" />
  </ItemGroup>

</Project>
