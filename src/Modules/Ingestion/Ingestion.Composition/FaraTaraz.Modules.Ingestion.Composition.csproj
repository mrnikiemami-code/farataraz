<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Module-owned composition seam for the Ingestion module (D-1; ADR-010 decision 14).

    This project owns ONLY dependency-injection wiring: it composes the module's Application
    use cases with the module's Infrastructure persistence behind a single `AddIngestionModule`
    entry point that the Host can call. It contains no business rules, no handlers, no domain
    types, no provider concept and no tenant decision.

    It exists so the composition-only Host can wire the module's persistence WITHOUT referencing
    the concrete `Ingestion.Infrastructure` assembly ("Host composes modules, never owns
    persistence", AGENTS.md). It is never referenced by Domain or Application. Its dependency
    direction is inward: it depends on the module's Application + Infrastructure.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ingestion.Application\FaraTaraz.Modules.Ingestion.Application.csproj" />
    <ProjectReference Include="..\Ingestion.Infrastructure\FaraTaraz.Modules.Ingestion.Infrastructure.csproj" />
  </ItemGroup>

</Project>
