<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Composition root for the FaraTaraz modular monolith (FMCA target, structure.md §10.1).

    This project has ZERO business authority. It only wires modules together through their
    module-local Composition extensions. It contains no use cases, no domain rules, no
    persistence, and no provider adapters. Business authority stays in the Application layer
    (ADR-009, structure.md §10.3).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\FaraTaraz.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Modules\MasterData\FaraTaraz.Modules.MasterData.csproj" />
    <ProjectReference Include="..\..\Modules\AccountingSources\AccountingSources.Domain\FaraTaraz.Modules.AccountingSources.csproj" />
    <ProjectReference Include="..\..\Modules\Ingestion\Ingestion.Domain\FaraTaraz.Modules.Ingestion.Domain.csproj" />
    <ProjectReference Include="..\..\Modules\Ingestion\Ingestion.Application\FaraTaraz.Modules.Ingestion.Application.csproj" />
    <!--
      Module-owned composition seams (D-1). The host references the seams, never the concrete
      Infrastructure/persistence assemblies: each seam wires its own module inward
      (ADR-010 decision 14). This keeps the Host composition-only while making the production
      dependency graph resolvable.
    -->
    <ProjectReference Include="..\..\Modules\Ingestion\Ingestion.Composition\FaraTaraz.Modules.Ingestion.Composition.csproj" />
    <ProjectReference Include="..\..\Modules\AccountingSources\AccountingSources.Composition\FaraTaraz.Modules.AccountingSources.Composition.csproj" />
  </ItemGroup>

</Project>
